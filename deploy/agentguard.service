[Unit]
Description=AgentGuard backend + dashboard
After=network.target

[Service]
WorkingDirectory=/opt/agent-guard
Environment=AGENTGUARD_LOCAL_WRITES=1
Environment=AGENTGUARD_DB=/opt/agent-guard/agentguard.db
ExecStart=/opt/agent-guard/.venv/bin/uvicorn backend.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target